---
const { title } = Astro.props;
const pathname = Astro.url.pathname;
import "../../styles/global.css";
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content="Panel de control inmobiliario para gestión de campañas, diseño, video y pauta digital." />
        <title>{title} | PanelInmobiliario PRO</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
        <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    </head>
    <body class="font-body-md text-[var(--color-on-surface)] antialiased min-h-screen flex flex-col" style="background-color:var(--color-surface)">

        <!-- Header / Nav -->
        <header id="app-header" class="fixed top-0 left-0 right-0 z-50 transition-shadow duration-200" style="background:rgba(255,255,255,0.95);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--color-outline-variant);opacity:0.98">
            <!-- Gradient accent strip -->
            <div class="h-0.5 w-full" style="background:linear-gradient(90deg,var(--color-primary-container),var(--color-tertiary-container),var(--color-secondary-container))"></div>

            <div class="h-14 max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between gap-2 sm:gap-4">

                <!-- Logo + Desktop Nav -->
                <div class="flex items-center gap-6 min-w-0">
                    <a href="/agente/dashboard" class="flex items-center gap-2.5 group cursor-pointer shrink-0 select-none" aria-label="PanelInmobiliario Home">
                        <div class="w-8 h-8 rounded-xl flex items-center justify-center shadow-sm transition-transform group-hover:scale-105" style="background:linear-gradient(135deg,var(--color-primary-container),var(--color-tertiary-container))">
                            <span class="material-symbols-outlined text-white" style="font-size:18px">domain</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <span class="font-bold tracking-tight text-sm" style="font-family:'Plus Jakarta Sans',sans-serif;color:var(--color-on-surface)">
                                Panel<span style="color:var(--color-primary-container)">Inmobiliario</span>
                            </span>
                            <span class="hidden xs:inline-block px-1.5 py-0.5 rounded font-bold" style="font-size:9px;background:var(--color-primary-fixed);color:var(--color-on-primary-fixed-variant)">PRO</span>
                        </div>
                    </a>

                    <nav class="hidden xl:flex items-center gap-1" role="navigation" aria-label="Navegación principal">
                        <a
                            href="/agente/dashboard"
                            id="nav-dashboard"
                            class={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition-all duration-150 ${pathname === '/agente/dashboard' ? 'text-on-surface font-semibold' : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low'}`}
                            style={pathname === '/agente/dashboard' ? 'background:var(--color-primary-fixed);color:var(--color-on-primary-fixed-variant)' : ''}
                        >
                            <span class="material-symbols-outlined" style="font-size:17px">dashboard</span>
                            Dashboard
                        </a>
                        <a
                            href="/agente/nuevo"
                            id="nav-nuevo"
                            class={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition-all duration-150 ${pathname === '/agente/nuevo' ? '' : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low'}`}
                            style={pathname === '/agente/nuevo' ? 'background:var(--color-primary-container);color:var(--color-on-primary)' : ''}
                        >
                            <span class="material-symbols-outlined" style="font-size:17px">add_circle</span>
                            Nuevo Requerimiento
                        </a>

                        <div class="w-px h-5 mx-1" style="background:var(--color-outline-variant)"></div>

                        <a
                            href="/equipo/diseno"
                            id="nav-diseno"
                            class={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition-all duration-150 ${pathname === '/equipo/diseno' ? '' : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low'}`}
                            style={pathname === '/equipo/diseno' ? 'background:var(--color-secondary-container);color:var(--color-on-secondary-container)' : ''}
                        >
                            <span class="material-symbols-outlined" style="font-size:17px">palette</span>
                            Diseño
                            <span class="px-1.5 py-0.5 rounded-full font-bold" style="font-size:10px;background:var(--color-secondary-container);color:var(--color-on-secondary-container)">Isac</span>
                        </a>
                        <a
                            href="/equipo/video"
                            id="nav-video"
                            class={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition-all duration-150 ${pathname === '/equipo/video' ? '' : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low'}`}
                            style={pathname === '/equipo/video' ? 'background:var(--color-tertiary-fixed);color:var(--color-on-tertiary-fixed-variant)' : ''}
                        >
                            <span class="material-symbols-outlined" style="font-size:17px">videocam</span>
                            Video
                            <span class="px-1.5 py-0.5 rounded-full font-bold" style="font-size:10px;background:var(--color-tertiary-fixed);color:var(--color-on-tertiary-fixed-variant)">Sebas</span>
                        </a>
                        <a
                            href="/equipo/cm"
                            id="nav-cm"
                            class={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition-all duration-150 ${pathname === '/equipo/cm' ? '' : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low'}`}
                            style={pathname === '/equipo/cm' ? 'background:var(--color-surface-container-high);color:var(--color-on-surface)' : ''}
                        >
                            <span class="material-symbols-outlined" style="font-size:17px">campaign</span>
                            CM
                            <span class="px-1.5 py-0.5 rounded-full font-bold" style="font-size:10px;background:var(--color-surface-container-highest);color:var(--color-on-surface-variant)">Brenda</span>
                        </a>
                    </nav>
                </div>

                <!-- Right Side -->
                <div class="flex items-center gap-2">
                    <!-- Mobile hamburger -->
                    <button id="btn-mobile-menu" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-drawer"
                        class="xl:hidden w-9 h-9 rounded-xl flex items-center justify-center transition-all active:scale-95"
                        style="color:var(--color-on-surface-variant);background:transparent"
                        onmouseenter="this.style.background='var(--color-surface-container-low)'"
                        onmouseleave="this.style.background='transparent'">
                        <span class="material-symbols-outlined" style="font-size:22px">menu</span>
                    </button>
                </div>
            </div>
        </header>

        <!-- Mobile Drawer Overlay -->
        <div id="mobile-overlay" class="xl:hidden fixed inset-0 z-[60] bg-black/40 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-250" aria-hidden="true"></div>

        <!-- Mobile Drawer Panel -->
        <aside id="mobile-drawer" role="navigation" aria-label="Menú móvil"
            class="xl:hidden fixed top-0 right-0 bottom-0 z-[70] w-72 max-w-[85vw] flex flex-col overflow-y-auto translate-x-full transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]"
            style="background:var(--color-surface-container-lowest);box-shadow:-4px 0 32px rgba(0,0,0,0.12)">

            <!-- Gradient strip -->
            <div class="h-1 w-full flex-shrink-0" style="background:linear-gradient(90deg,var(--color-primary-container),var(--color-tertiary-container))"></div>

            <!-- Drawer Header -->
            <div class="flex items-center justify-between p-5 flex-shrink-0" style="border-bottom:1px solid var(--color-surface-container)">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl flex items-center justify-center text-white" style="background:linear-gradient(135deg,var(--color-primary-container),var(--color-tertiary-container))">
                        <span class="material-symbols-outlined" style="font-size:18px">domain</span>
                    </div>
                    <div>
                        <span class="font-bold text-sm" style="font-family:'Plus Jakarta Sans',sans-serif;color:var(--color-on-surface)">PanelInmobiliario</span>
                        <span class="block text-[10px]" style="color:var(--color-outline)">Marketing &amp; Campañas</span>
                    </div>
                </div>
                <button id="btn-close-drawer" aria-label="Cerrar menú"
                    class="w-8 h-8 rounded-lg flex items-center justify-center transition-all active:scale-90"
                    style="color:var(--color-outline)"
                    onmouseenter="this.style.background='var(--color-surface-container)'"
                    onmouseleave="this.style.background='transparent'">
                    <span class="material-symbols-outlined" style="font-size:20px">close</span>
                </button>
            </div>

            <!-- Nav Links -->
            <nav class="flex flex-col gap-1 p-4 flex-1">
                <a href="/agente/dashboard" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all"
                    style={pathname === '/agente/dashboard' ? 'background:var(--color-primary-fixed);color:var(--color-on-primary-fixed-variant)' : 'color:var(--color-on-surface)'}>
                    <span class="material-symbols-outlined" style="font-size:20px">dashboard</span>
                    <span>Dashboard</span>
                </a>
                <a href="/agente/nuevo" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all"
                    style={pathname === '/agente/nuevo' ? 'background:var(--color-primary-container);color:var(--color-on-primary)' : 'color:var(--color-on-surface)'}>
                    <span class="material-symbols-outlined" style="font-size:20px">add_circle</span>
                    <span>Nuevo Requerimiento</span>
                </a>

                <div class="my-2 flex items-center gap-2">
                    <div class="h-px flex-1" style="background:var(--color-surface-container)"></div>
                    <span class="text-[10px] font-bold uppercase tracking-wider" style="color:var(--color-outline)">Equipos</span>
                    <div class="h-px flex-1" style="background:var(--color-surface-container)"></div>
                </div>

                <a href="/equipo/cm" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all"
                    style={pathname === '/equipo/cm' ? 'background:var(--color-surface-container-high);color:var(--color-on-surface)' : 'color:var(--color-on-surface)'}>
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined" style="font-size:20px">campaign</span>
                        <span>CM — Brenda</span>
                    </div>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold" style="background:var(--color-surface-container-highest);color:var(--color-on-surface-variant)">CM</span>
                </a>
                <a href="/equipo/video" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all"
                    style={pathname === '/equipo/video' ? 'background:var(--color-tertiary-fixed);color:var(--color-on-tertiary-fixed-variant)' : 'color:var(--color-on-surface)'}>
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined" style="font-size:20px">movie</span>
                        <span>Video — Sebas / Marco</span>
                    </div>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold" style="background:var(--color-tertiary-fixed);color:var(--color-on-tertiary-fixed-variant)">Video</span>
                </a>
                <a href="/equipo/diseno" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-semibold transition-all"
                    style={pathname === '/equipo/diseno' ? 'background:rgba(108,248,187,0.2);color:var(--color-on-secondary-container)' : 'color:var(--color-on-surface)'}>
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined" style="font-size:20px">palette</span>
                        <span>Diseño — Isac</span>
                    </div>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold" style="background:var(--color-secondary-container);color:var(--color-on-secondary-container)">Diseño</span>
                </a>
            </nav>

            <!-- Drawer Footer -->
            <div class="p-4 mt-auto" style="border-top:1px solid var(--color-surface-container)">
                <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full animate-pulse" style="background:var(--color-secondary)"></div>
                    <span class="text-xs" style="color:var(--color-outline)">Sistema en línea · v2026.09</span>
                </div>
            </div>
        </aside>

        <script is:inline>
            (function() {
                const btnOpen    = document.getElementById('btn-mobile-menu');
                const btnClose   = document.getElementById('btn-close-drawer');
                const drawer     = document.getElementById('mobile-drawer');
                const overlay    = document.getElementById('mobile-overlay');

                function openDrawer() {
                    drawer.classList.remove('translate-x-full');
                    overlay.classList.remove('opacity-0', 'pointer-events-none');
                    overlay.classList.add('opacity-100');
                    document.body.style.overflow = 'hidden';
                    btnOpen && (btnOpen.setAttribute('aria-expanded', 'true'));
                }

                function closeDrawer() {
                    drawer.classList.add('translate-x-full');
                    overlay.classList.add('opacity-0', 'pointer-events-none');
                    overlay.classList.remove('opacity-100');
                    document.body.style.overflow = '';
                    btnOpen && (btnOpen.setAttribute('aria-expanded', 'false'));
                }

                if (btnOpen)  btnOpen.addEventListener('click', openDrawer);
                if (btnClose) btnClose.addEventListener('click', closeDrawer);
                if (overlay)  overlay.addEventListener('click', closeDrawer);

                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') closeDrawer();
                });

                // Scroll-based header shadow
                const header = document.getElementById('app-header');
                if (header) {
                    window.addEventListener('scroll', function() {
                        if (window.scrollY > 8) {
                            header.style.boxShadow = '0 2px 16px rgba(0,0,0,0.08)';
                        } else {
                            header.style.boxShadow = 'none';
                        }
                    }, { passive: true });
                }
            })();
        </script>

        <!-- Page Content -->
        <main class="flex-1 w-full pt-[57px]" style="background-color:var(--color-surface)">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 sm:py-7">
                <slot />
            </div>
        </main>

        <!-- Footer -->
        <footer class="w-full mt-auto" style="background:var(--color-surface-container-lowest);border-top:1px solid var(--color-surface-container)">
            <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col md:flex-row items-center justify-between gap-3 font-body-sm" style="color:var(--color-on-surface-variant)">
                <div class="flex items-center gap-2.5">
                    <div class="w-6 h-6 rounded-lg flex items-center justify-center" style="background:linear-gradient(135deg,var(--color-primary-container),var(--color-tertiary-container))">
                        <span class="material-symbols-outlined text-white" style="font-size:14px">domain</span>
                    </div>
                    <span class="font-semibold text-xs" style="color:var(--color-on-surface)">PanelInmobiliario</span>
                    <span class="text-xs">© 2026 Workspace de Marketing &amp; Campañas.</span>
                </div>
                <div class="flex items-center gap-4 text-xs">
                    <a href="#" class="transition-colors hover:text-[var(--color-primary-container)]">Soporte</a>
                    <a href="#" class="transition-colors hover:text-[var(--color-primary-container)]">Guías de Marca</a>
                    <div class="flex items-center gap-1.5">
                        <div class="w-1.5 h-1.5 rounded-full" style="background:var(--color-secondary);animation:pulse 2s infinite"></div>
                        <span>Sistema activo</span>
                    </div>
                </div>
            </div>
        </footer>

    </body>
</html>